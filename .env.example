# Homa — Environment Variables
# Copy this to ~/.openclaw/.env and fill in your values.

# Required: Anthropic API key (Homa's brain)
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: fal.ai API key (image generation for picture books, flash cards, coloring pages)
# Get one at https://fal.ai/dashboard/keys
FAL_API_KEY=

# Optional: SerpAPI key (Google Images search for curriculum visuals)
# Get one at https://serpapi.com
SERPAPI_KEY=

# Optional: Vercel token (auto-deploy the web dashboard)
# Get one at https://vercel.com/account/tokens
VERCEL_TOKEN=
