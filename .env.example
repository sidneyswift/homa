# ─────────────────────────────────────────────────────────────────────────────
# Homa environment: .env.example (committed; safe: contains no raw secrets)
#
# Values marked op:// are 1Password secret references (vault "Agents"),
# resolved at runtime. Policy: secrets live in 1Password only, never paste
# raw tokens here and never commit a resolved .env (it's gitignored).
#
# On any machine with the 1Password app signed in to recoupable.1password.com:
#   1. brew install 1password-cli
#   2. 1Password app → Settings → Developer → "Integrate with 1Password CLI"
#   3. Run anything with secrets injected into the process env only:
#        op run --env-file=.env.example -- <your command>
#
# Need a literal .env locally (last resort, avoid)?
#        op inject -i .env.example -o .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Slack: Cosmo bot (workspace "Cosmo 🌀", app A0AKPL94SEL) ─────────────────
# Web API auth, sufficient to read channel history and download attachments.
# Verify:  curl -s -H "Authorization: Bearer $SLACK_BOT_TOKEN" https://slack.com/api/auth.test
SLACK_BOT_TOKEN="op://Agents/Cosmo Slack Tokens/bot_token"

# Socket Mode token, only needed for realtime event listening, not for
# reading history. Uncomment if you build a live listener.
# SLACK_APP_TOKEN="op://Agents/Cosmo Slack Tokens/app_token"

# ── Slack channel IDs (not secret; IDs are stable even when names change) ────
SLACK_INSPO_CHANNEL_ID=C0BHQDC033M      # #homa-inspo, reference drops (private)
SLACK_FEEDBACK_CHANNEL_ID=C0BHTC78R1B   # #homa-feedback (private)
SLACK_DEV_CHANNEL_ID=C0BF3QUABDH        # #homa-dev (private)

# Reading #homa-inspo:
#   curl -s -H "Authorization: Bearer $SLACK_BOT_TOKEN" \
#     "https://slack.com/api/conversations.history?channel=$SLACK_INSPO_CHANNEL_ID&limit=50"
# Most inspo messages are file drops: fetch messages[].files[].url_private
# with the same Authorization header to download the PDFs/images.

# ── Vercel Blob (durable home for downloaded inspo originals) ────────────────
# Founder ruling inspo-originals-offrepo (2026-07-20): downloaded copyrighted
# originals never live in git; .cosmo/inspo-files/ and .cosmo/inspo-images/
# are gitignored working copies, and the durable copy uploads to Blob.
#
# Homa's production store id is pkvvudjdhxk33dig (verified against the live
# materials ledger 2026-07-20). Blob rw tokens are store-scoped, and Cosmo's
# machine holds Vercel credentials for more than one project, so ALL uploads
# go through .cosmo/scripts/blob-upload.sh, which refuses any token whose
# embedded store id is not exactly that store.
#
# Preferred token source on a machine with the Vercel CLI linked to the Homa
# web project: run `vercel env pull .env.blob` inside apps/web and source it.
# The 1Password reference below is the fallback for machines without the CLI;
# it resolves only if the item exists in the Agents vault.
BLOB_READ_WRITE_TOKEN="op://Agents/Homa Blob/read_write_token"
