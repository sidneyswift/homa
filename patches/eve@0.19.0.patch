+import type { HookPayload, SessionAuthContext } from '#channel/types.js';
+import type { TurnStepInput } from '#execution/durable-session-migrations/turn-workflow.js';
+import type { DurableStepResult } from '#execution/workflow-steps.js';
+/** Preview experiment only. Reads trusted server configuration at authenticated acceptance. */
