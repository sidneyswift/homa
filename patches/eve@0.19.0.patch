new file mode 100644
index 0000000000000000000000000000000000000000..2db3451588d59e8ddaf105f8cdcb708f4520a873
--- /dev/null
+++ b/dist/src/internal/homa-timing.js
@@ -0,0 +1,17 @@
+import { trace } from "#compiled/@opentelemetry/api/index.js";
+
+// Metadata-only instrumentation of managed steps, never workflow replay code.
+export async function timeHomaRuntime(name, operation, sessionId) {
+  return trace.getTracer("homa-chat-timing").startActiveSpan(name, async span => {
+    const startedAtMs = Date.now();
+    const started = performance.now();
+    let outcome = "error";
+    const spanId = span.spanContext().spanId;
+    const receiptId = crypto.randomUUID();
+    const clockId = globalThis[Symbol.for("homa.chat-timing.clock")] ??= crypto.randomUUID();
+    const write = record => { try { const value = {version:1, clockId, kind:"runtime", name, sessionId, receiptId, spanId, ...record}; const writer = globalThis[Symbol.for("homa.chat-timing.record")]; if (writer) writer(value); else console.info("[chat-timing]", JSON.stringify(value)); } catch {} };
+    write({phase:"start", startedAtMs});
+    try { const result = await operation(); outcome = "ok"; return result; }
+    finally { write({phase:"end", startedAtMs, durationMs:performance.now()-started, outcome}); span.end(); if (name === "homa.runtime.turnStep" || name === "homa.runtime.dispatchTurnStep") globalThis[Symbol.for("homa.chat-timing.flush")]?.(); }
+  });
+}
