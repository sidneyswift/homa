index 0000000000000000000000000000000000000000..70e8524b193cc17d12d07e4defaeca61d70af1b7
--- /dev/null
+++ b/dist/src/execution/inline-turn.js
@@ -0,0 +1,29 @@
+import { turnStep } from '#execution/workflow-steps.js';
+import { readAcceptedDeploymentId } from '#execution/accepted-delivery-deployment.js';
+
+// One durable step only. Complex results are carried to the existing child runner.
+export async function runInlineTurn(input) {
+  // Recorded session mode and lineage keep this trial on root interactive turns.
+  if (input.mode !== 'conversation' || input.capabilities?.requestInput !== true ||
+      input.serializedContext['eve.parentSession'] !== undefined ||
+      (input.serializedContext['eve.subagentDepth'] ?? 0) !== 0) return { kind: 'child' };
+  const acceptedDeploymentId = readAcceptedDeploymentId(input.delivery);
+  if (acceptedDeploymentId === undefined) return { kind: 'child' };
+  const beforeStep = { serializedContext: input.serializedContext, sessionState: input.sessionState };
+  const result = await turnStep({
+    acceptedDeploymentId, input: input.delivery, parentWritable: input.parentWritable,
+    serializedContext: input.serializedContext, sessionState: input.sessionState,
+  });
+  if (result.requiresChildDispatch === true) return { kind: 'child' };
+  const initialStep = { beforeStep, result };
+  if (result.action === 'done') return {
+    kind: 'result', action: { kind: 'done', output: result.output ?? '', isError: result.isError,
+      serializedContext: result.serializedContext, sessionState: result.sessionState },
+  };
+  if (result.action === 'park' && result.pendingRuntimeActionKeys === undefined &&
+      (result.hasPendingAuthorization || (result.hasPendingInputBatch && input.capabilities?.requestInput === true) || input.mode === 'conversation')) {
+    return { kind: 'result', action: { kind: 'park', authorizationNames: result.authorizationNames,
+      serializedContext: result.serializedContext, sessionState: result.sessionState } };
+  }
+  return { kind: 'child', initialStep };
+}
