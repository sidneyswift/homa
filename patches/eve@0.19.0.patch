+                completed = true;
+                return;
+            }
+            yield result.value;
+        }
+    } finally{
+        if (!completed && iterator.return !== undefined) {
+            try {
+                const closing = iterator.return();
+                void Promise.resolve(closing).catch(()=>{});
+            } catch  {}
+        }
+    }
