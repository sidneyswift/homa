+            return;
+        }
+        next.then((result)=>{
+            failureSignal.removeEventListener("abort", onFailure);
+            resolve(result);
+        }, (error)=>{
+            failureSignal.removeEventListener("abort", onFailure);
+            reject(error);
+        });
+    });
