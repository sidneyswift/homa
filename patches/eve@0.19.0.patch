@@ -0,0 +1,19 @@
+// Protected-preview experiment only. Stamped after server authentication, never read during replay.
+export function readEligibleAcceptedDeploymentId(auth) {
+  const allowedPrincipal = process.env.EVE_EXPERIMENT_INLINE_PRINCIPAL_ID;
+  if (process.env.VERCEL_ENV !== 'preview' || process.env.EVE_EXPERIMENT_INLINE_TURN !== '1' ||
+      typeof allowedPrincipal !== 'string' || !/^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/.test(allowedPrincipal) ||
+      auth?.principalType !== 'user' || auth.principalId !== allowedPrincipal) return undefined;
+  return process.env.VERCEL_DEPLOYMENT_ID?.trim() || undefined;
+}
+// Trusted internal metadata, written by the server runtime after channel authentication.
+export function readAcceptedDeploymentId(delivery) {
+  return delivery?.kind === 'deliver' && typeof delivery.acceptedDeploymentId === 'string' && delivery.acceptedDeploymentId.length > 0
+    ? delivery.acceptedDeploymentId : undefined;
+}
+export function deferMismatchedInlineTurnStep(input) {
+  if (input.acceptedDeploymentId !== undefined && process.env.VERCEL_DEPLOYMENT_ID?.trim() !== input.acceptedDeploymentId) {
+    return { action: 'continue', requiresChildDispatch: true,
+      serializedContext: input.serializedContext, sessionState: input.sessionState };
+  }
+}
