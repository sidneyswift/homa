+          typeof part.toolCallId === "string") {
+        const skill = part.input?.skill;
+        // Ambiguous duplicate ids must never select an unrelated skill.
+        if (calls.has(part.toolCallId)) loaded.delete(calls.get(part.toolCallId));
+        calls.set(part.toolCallId, calls.has(part.toolCallId) ? undefined :
+          typeof skill === "string" && catalog.has(skill) ? skill : undefined);
+      }
+      if (message.role === "tool" && part.type === "tool-result" &&
+          part.toolName === "load_skill" && part.providerExecuted !== true &&
+          (part.output?.type === "text" || part.output?.type === "json") &&
+          typeof part.output.value === "string") {
+        const skill = calls.get(part.toolCallId);
+        if (skill !== undefined) loaded.add(skill);
+      }
+    }
+  }
+  for (const skill of loaded) {
+    const declared = catalog.get(skill);
+    if (typeof declared !== "string") continue;
+    for (const name of declared.split(",").map((name) => name.trim())) {
+      if (/^[A-Za-z0-9_-]+$/.test(name)) names.add(name);
+    }
+  }
+  return names;
+}
+
+/** Internal preview experiment. Never clone a built tool: Eve approval is
+ * registered in a WeakMap keyed by that exact object. */
+export async function applyPreviewDeferredTools(tools, input) {
+  if (process.env.VERCEL_ENV !== "preview" ||
+      process.env.HOMA_PREVIEW_ASTRA_DEFERRED_TOOLS !== "1") return tools;
+  const reference = input.modelReference;
+  if (reference.id !== MODEL_ID || reference.source !== undefined ||
+      input.model !== MODEL_ID) return tools;
+  const gateway = reference.providerOptions?.gateway;
+  // The Priority trial is separate. Do not silently combine provider controls.
+  if (gateway?.serviceTier !== undefined || gateway?.speed !== undefined ||
+      process.env.HOMA_PREVIEW_ASTRA_PRIORITY === "1") return tools;
+  const fallbacks = gateway?.models;
+  if (fallbacks !== undefined && (!Array.isArray(fallbacks) ||
+      fallbacks.some((id) => id !== MODEL_ID))) return tools;
+  if (input.disabledProviderTools?.has(SEARCH_NAME)) return tools;
+  // Check before mutation. Neither an authored name nor another provider alias
+  // can be overwritten by the hosted search definition.
+  if (Object.hasOwn(tools, SEARCH_NAME) || Object.values(tools).some(
+      (tool) => tool?.type === "provider" && tool.id === "openai.tool_search")) {
+    throw new Error("Deferred tool preview conflicts with an existing tool_search tool.");
+  }
+  const linkedNames = process.env.HOMA_PREVIEW_SKILL_LINKED_TOOLS === "1"
+    ? selectSkillLinkedToolNames(input.messages,
+        contextStorage.getStore()?.get(BundleKey)?.resolvedAgent.skills ?? [])
+    : new Set();
+  const linked = Object.entries(tools).filter(([name, tool]) =>
+    linkedNames.has(name) && tool !== undefined && tool.type !== "provider" &&
+    !EAGER_CONTROL_TOOLS.has(name));
+  const deferred = Object.entries(tools).filter(([name, tool]) =>
+    tool !== undefined && tool.type !== "provider" &&
+    !EAGER_CONTROL_TOOLS.has(name) && !linkedNames.has(name) &&
+    tool.providerOptions?.openai?.deferLoading !== false);
+  // Only adjust already-authorized, already-built tools. Preserve object
+  // identity because the approval registry uses those objects as keys.
+  for (const [, tool] of linked) {
+    tool.providerOptions = {
+      ...tool.providerOptions,
+      openai: { ...tool.providerOptions?.openai, deferLoading: false },
+    };
+  }
+  if (deferred.length === 0) return tools;
+  const search = openai.tools.toolSearch({ execution: "server" });
+  for (const [, tool] of deferred) {
+    tool.providerOptions = {
+      ...tool.providerOptions,
+      openai: { ...tool.providerOptions?.openai, deferLoading: true },
+    };
+  }
+  tools[SEARCH_NAME] = search;
+  try {
+    console.info("[chat-deferred-tools]", JSON.stringify({
+      stage: "applied", atMs: Date.now(), sessionId: input.sessionId,
+      turnId: input.turnId, stepIndex: input.stepIndex,
+      deferredToolCount: deferred.length, advertisedToolCount: Object.keys(tools).length,
+      skillLinkedToolCount: linked.length,
+    }));
+  } catch { /* Observation cannot interrupt a turn. */ }
+  return tools;
+}
