  "layer1_philosophy": {
    "methodology": "A standards-decoding and instructional-planning companion for grades 3 to 5. It restates each literacy anchor, translates the standard into student actions, supplies comprehension questions and academic vocabulary, then asks the teacher to plan whole-class, small-group, and individual practice.",
    "principles": [
      "Treat standards as goals to interpret into rich daily learning, not as a script.",
      "Read the same standard horizontally across grades and vertically within its strand.",
      "Pair every standards claim with specific student actions and text evidence.",
      "Integrate several standards in meaningful reading, writing, speaking, and language work.",
      "Plan differentiation, grouping, texts, materials, and individual conferring before teaching."
    ],
    "evidence": [
      {
        "claim": "The companion converts standards into daily teaching",
        "quote": "Turning Standards Into Daily Teaching"
      },
      {
        "claim": "Standards are translated into accessible teacher language",
        "quote": "plain-English synopses of the standards"
      },
      {
        "claim": "Planning spans multiple instructional arrangements",
        "quote": "whole class lessons, think-alouds, read-alouds, small-group practice"
      }
    ],
    "learningTheory": "Explicit modeling, close reading, evidence-based discussion, guided practice, differentiation, collaboration, reflection, and transfer across texts.",
    "assessmentApproach": "Use standards-aligned questions, observation during small-group and independent work, student explanations, conferences, rubrics or checklists, and authentic written or spoken products.",
    "parentRole": "For home use, translate one standard into a concrete student action, choose an accessible text, model the thinking move aloud, then listen to the child's evidence and preserve notes for the next lesson.",
    "knowledgeBankMatches": [
      {
        "topicKey": "standards-to-daily-literacy-planning",
