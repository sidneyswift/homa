# ── Secrets: never committed ────────────────────────────────────────────────
.env
.env.*
!.env.example
*.local
**/service-env/
**/*.key
**/*.crt

# ── Local-only reference trees (contain live secrets + family data) ─────────
# These NEVER go to GitHub. Product code ports FROM homa-template deliberately.
homa-macmini/
homa-research/

# ── Scratch output from scripts ─────────────────────────────────────────────
.eve-upgrade-check.log
.superpowers/
supabase/.temp/
.context/compound-engineering/ce-optimize/prompt-suggestions/iteration-*-diagnostics.json

# ── Junk ────────────────────────────────────────────────────────────────────
.DS_Store
.worktrees/
node_modules/
.vercel
.eve/
.workflow-data/
.turbo/
*.tsbuildinfo

# Template is canonical on the remote (branch+tag template-archive); local copy stays untracked
homa-template/
.output/

# Downloaded inspo originals are copyrighted working copies; durable copies
# live in Blob (founder ruling inspo-originals-offrepo, 2026-07-20).
.cosmo/inspo-files/
.cosmo/inspo-images/

# Extracted text sidecars (.cosmo/text/<id>.txt) back aboutness quote
# verification. The extracted text of a copyrighted book IS the copyrighted
# work, so the same ruling applies: local working copy plus Blob, never git.
.cosmo/text/

# Per-page masters written by book-intake.py. Page images of a captured book
# are the original in a different shape; same ruling, same treatment. The
# manifest lives beside them, so it stays out of git too: its provenance is
# copied into the item JSON's capture block, which is tracked.
.cosmo/masters/

# Python bytecode
__pycache__/
*.pyc
