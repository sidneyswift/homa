{
  "name": "homa",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "build": "turbo run build",
    "check:docs": "node scripts/docs-reconciliation-check.mjs",
    "check:child-progress": "tsx --tsconfig apps/web/tsconfig.json --test \"packages/core/src/events.test.ts\" \"apps/web/lib/child-progress/*.test.ts\" \"apps/web/lib/map/walk-answer-event.test.ts\" \"scripts/reconcile-child-progress.test.ts\"",
    "check:events": "tsx scripts/events-check.mts",
    "check:isolation": "node scripts/isolation-check.mjs",
    "check:map": "tsx scripts/map-check.mts && tsx --test apps/web/lib/map/walk-answer-event.test.ts apps/web/lib/map/trajectory-eras.test.ts",
    "check:progress-ui": "tsx --tsconfig apps/web/tsconfig.json --test apps/web/lib/child-progress/flag.test.ts apps/web/lib/child-progress/view-copy.test.ts apps/web/lib/child-progress/view-schema.test.ts apps/web/lib/child-progress/page-state.test.ts apps/web/lib/child-progress/kid-action.test.ts apps/web/lib/child-progress/route-policy.test.ts apps/web/lib/child-progress/progress-ui-script.test.ts apps/web/lib/child-progress/tool-result-contract.test.ts apps/web/lib/view-context.test.ts apps/web/components/dashboard/sidebar-nav.test.ts apps/web/components/dashboard/kid-view-progress.test.tsx apps/web/components/progress/ask-homa-about-child-action.test.ts apps/web/components/progress/retry-progress-action.test.ts apps/web/components/progress/progress-unavailable.test.tsx apps/web/components/progress/progress-view.test.tsx apps/web/components/progress/report-snapshot.test.tsx apps/web/components/progress/progress-detail-panel.test.tsx apps/web/components/progress/resolve-conflict-request.test.ts apps/web/lib/child-progress/map-model.test.ts apps/web/app/app/progress-message-parts.test.ts apps/web/app/app/progress-chat-cards.test.tsx apps/web/app/app/message-parts-progress.test.tsx apps/web/app/app/chat-client-progress-wiring.test.ts apps/web/app/app/progress-client-boundary.test.ts apps/web/app/app/progress-interaction-policy.test.ts apps/web/app/app/progress-action-lifecycle.test.ts apps/web/app/app/chat-send-policy.test.ts apps/web/app/onboarding/map-answer-attempt.test.ts apps/web/app/onboarding/receipt-correction-intent.test.ts",
    "admin:smoke": "tsx --tsconfig apps/web/tsconfig.json scripts/admin-console-smoke.mts",
    "check:admin": "tsx --tsconfig apps/web/tsconfig.json --test apps/web/lib/admin/stage.test.ts apps/web/lib/email-webhook.test.ts apps/web/lib/observability/agent-trace.test.ts",
    "check:research-brief": "tsx --test apps/web/lib/tasks/research-brief-format.test.ts",
    "check:tasks-ui": "tsx --tsconfig apps/web/tsconfig.json --test apps/web/app/app/tasks/tasks-view.test.tsx apps/web/lib/tasks/dispatch-input.test.ts",
    "check:chat-ui": "tsx --tsconfig apps/web/tsconfig.json --test apps/web/lib/attachments/markers.test.ts apps/web/app/app/message-parts-attachments.test.tsx apps/web/app/app/transcript-days.test.ts",
    "check:skills-targeting": "node scripts/skills-targeting-check.mjs",
    "check:continuity": "tsx --test \"apps/web/lib/conversation-continuity/*.test.ts\" \"apps/web/lib/email-inbound-continuity.test.ts\" \"apps/web/lib/map/email-submission.test.ts\" \"apps/web/lib/map/family-actor-auth.test.ts\" \"apps/web/lib/sms-inbound-auth.test.ts\" \"apps/web/lib/sms-progress.test.ts\" \"apps/web/lib/sms-session-epoch.test.ts\" \"apps/web/lib/voice/telnyx-api.test.ts\"",
    "child-progress:e2e": "pnpm test:child-progress:postgres",
    "test:child-progress:postgres": "NODE_OPTIONS=--conditions=react-server tsx scripts/child-progress-postgres-test.mts",
    "check:taxonomy": "node packages/taxonomy/scripts/validate.mjs && tsx scripts/taxonomy-check.mts && tsx --test packages/taxonomy/src/progress.test.ts",
    "taxonomy:progress": "tsx packages/taxonomy/scripts/generate-progress-index.mts",
    "taxonomy:slugs": "tsx packages/taxonomy/scripts/generate-slug-map.mts",
    "check:sources": "tsx scripts/benchmarks-freshness.mts",
    "dev": "turbo run dev",
    "eval:recall": "tsx scripts/recall-eval.mts",
    "eval:continuity": "tsx scripts/conversation-continuity-model-eval.mts",
    "eval:research-brief": "tsx scripts/research-brief-format-eval.mts",
    "gen:brand": "tsx scripts/brand-assets.mts",
    "gen:socials": "tsx scripts/socials-starter-pack-assets.mts",
    "knowledge:revert": "tsx scripts/knowledge-revert.mts",
    "knowledge:seed": "tsx scripts/knowledge-seed.mts",
    "lint": "turbo run lint",
    "map:narrative-fixtures": "tsx scripts/map-narrative-fixtures.mts",
    "materials:calibrate": "tsx scripts/materials-calibration.mts",
    "progress:reconcile": "tsx scripts/reconcile-child-progress.mts",
    "usage:report": "tsx scripts/usage-report.mts",
    "pull:state-requirements": "tsx scripts/state-requirements-pull.mts",
    "report:norms": "tsx scripts/map-norms-report.mts",
    "seed:state-requirements": "tsx scripts/state-requirements-seed.mts",
    "tasks:e2e": "tsx scripts/tasks-e2e.mts",
    "continuity:e2e": "tsx scripts/conversation-continuity-e2e.mts",
    "telnyx:assistant-info": "tsx scripts/telnyx-assistant-info.mts",
    "telnyx:call-transcripts": "tsx scripts/telnyx-call-transcripts.mts",
    "telnyx:calls-today": "tsx scripts/telnyx-calls-today.mts",
    "telnyx:curriculum:provision": "tsx scripts/telnyx-curriculum-provision.mts",
    "telnyx:provision": "tsx scripts/telnyx-provision.mts",
    "telnyx:transcripts:sync": "tsx scripts/telnyx-transcripts-sync.mts",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "postgres": "^3.4.9",
    "satori": "^0.26.0",
    "sharp": "^0.35.3",
    "tsx": "^4.23.0",
    "turbo": "^2.5.0"
  }
}
