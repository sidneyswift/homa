    "knowledge:seed": "tsx scripts/knowledge-seed.mts",
    "lint": "turbo run lint",
    "map:narrative:fixtures": "tsx scripts/map-narrative-fixtures.mts",
    "materials:calibrate": "tsx scripts/materials-calibration.mts",
