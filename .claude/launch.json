{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "onboarding",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "web", "dev"],
      "port": 3007,
      "autoPort": false,
      "url": "http://localhost:3007"
    },
    {
      "name": "homa-web",
      "runtimeExecutable": "corepack",
      "runtimeArgs": [
        "pnpm",
        "--filter",
        "web",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "mobile-metro",
      "runtimeExecutable": "corepack",
      "runtimeArgs": ["pnpm", "--filter", "mobile", "start"],
      "port": 8081,
      "autoPort": false
    }
  ]
}
