# Copy to apps/mobile/.env for local dev. EXPO_PUBLIC_ values are compiled
# into the app bundle and are safe to be public; RLS is the security boundary.
# Never put a service key or any server-only secret in this file.

# Same Supabase project as apps/web (homa-prod), same publishable key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The Next.js origin that hosts the eve agent routes (/eve/v1/*).
# Production: https://thankshoma.com
# Local dev: http://localhost:3000 works in the iOS simulator; a real phone
# needs your Mac's LAN IP, e.g. http://192.168.1.20:3000 (same wifi).
EXPO_PUBLIC_API_URL=

# Optional. A Sentry DSN is not a secret (Sentry's own docs say so), so it
# is EXPO_PUBLIC_ like everything else here. Crash reporting (src/lib/
# crash-reporting.ts) is a clean no-op when this is unset, which it is
# everywhere until a founder creates the Sentry project.
EXPO_PUBLIC_SENTRY_DSN=
