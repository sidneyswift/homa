{
  "expo": {
    "name": "Homa",
    "slug": "homa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "homa",
    "userInterfaceStyle": "light",
    "updates": {
      "url": "https://u.expo.dev/916ce7cf-5c57-4036-a9a9-af8651f1624a"
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.thankshoma.homa",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "Homa uses your microphone when you choose to talk or record a lesson.",
        "NSCameraUsageDescription": "Homa may use your camera during a live conversation when you choose to share what you are seeing.",
        "NSCalendarsWriteOnlyAccessUsageDescription": "Homa adds only the planner items you choose. It cannot read your calendar."
      }
    },
    "android": {
      "package": "com.thankshoma.homa",
      "blockedPermissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#F7F4EE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-apple-authentication",
      [
        "expo-audio",
        {
          "microphonePermission": "Homa uses your microphone when you choose to talk or record a lesson.",
          "enableBackgroundRecording": false
        }
      ],
      "expo-iap",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F4EE",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "./plugins/with-write-only-calendar"
    ],
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "916ce7cf-5c57-4036-a9a9-af8651f1624a"
      }
    },
    "owner": "sidneyswift"
  }
}
