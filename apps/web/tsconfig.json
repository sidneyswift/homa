{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    // noEmit is already true, so this only relaxes tsc's specifier
    // diagnostic; runtime resolution (tsx/esbuild, Next's bundler) already
    // accepts explicit .mts/.ts specifiers regardless of this flag. Needed
    // for scripts/skill-archive-*.mts, which import a sibling .mts module
    // with an explicit extension because tsx's ESM resolver requires one
    // for .mts entry files (unlike extensionless .ts-to-.ts imports).
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "tsBuildInfoFile": ".next/cache/typescript/tsconfig.tsbuildinfo",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
