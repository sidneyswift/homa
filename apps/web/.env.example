# Copy to .env.local for local dev; set the same values in Vercel env vars.
# The publishable key is designed to be public; RLS is the security boundary.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only database password for direct Postgres libraries and operational
# scripts. Never expose it to browser or mobile code.
SUPABASE_DB_PASSWORD=

# Server-only Supabase secret key. Account deletion uses it through the
# Storage API to remove adult avatar bytes before deleting their Auth owners.
SUPABASE_SECRET_KEY=

# Server-only: Resend key for report/reminder/retest email (lib/map/email.ts).
# Unset locally = emails are skipped with a console note, nothing breaks.
RESEND_API_KEY=
RESEND_INBOUND_SECRET=
RESEND_WEBHOOK_SECRET=

# Shared secret the Vercel cron sends as a Bearer token to /api/map/cron.
# Must match the CRON_SECRET env var in Vercel or the hourly cron 401s.
CRON_SECRET=

# Server-only origin for protected same-deployment requests. Production must
# use HTTPS. Local development may use HTTP only for localhost or 127.0.0.1.
HOMA_INTERNAL_ORIGIN=http://localhost:3000

# Proactive task gates. Only the exact string "true" enables each loop.
# Registration or a true flag does not prove that a production run succeeded.
JOURNAL_PROMPT_ENABLED=
MORNING_BRIEF_ENABLED=
FLEET_RESEARCH_ENABLED=
RESEARCH_TOPICS_PER_NIGHT=

# Device sync mailbox (mac-mini push/pull + applier cron). Dark unless
# exactly "true". Device tokens live in sync_devices (hashed); the mini
# holds the raw token, never CRON_SECRET or SUPABASE_DB_PASSWORD.
HOMA_DEVICE_SYNC_ENABLED=

# Optional absolute-URL override for links inside emails (defaults to
# https://thankshoma.com); set on previews so emailed links point back at
# the preview deployment.
NEXT_PUBLIC_SITE_URL=

# The LLM report narrative (D8 overturn, 2026-07-06). Off (unset) = the
# template sentences render everywhere except the sample page's committed
# fixture. The founder flips this to "true" in prod after the fixture
# read-aloud; local e2e sets it in .env.local.
REPORT_NARRATIVE_ENABLED=

# Live signed-in Progress hierarchy. Only the exact value "true" enables
# /app/progress and redirects legacy in-app report routes. Leave unset until
# the additive ChildProgress migration and final reconciliation are complete.
HOMA_LIVE_PROGRESS_ENABLED=
# Dense, read-only taxonomy abilities graph on the Progress page. Only the
# exact value "true" enables it; provision "false" for the first production
# deploy and leave it disabled until the deployment probes pass. Roll back by
# setting it to "false" before changing any broader Progress flags.
HOMA_ABILITIES_EXPLORER_ENABLED=

# Saved next-skill subject lessons with a generated practice page. Only the
# exact value "true" enables reads or writes. Leave unset until the additive
# subject_lessons migration is applied.
HOMA_SUBJECT_LESSONS_ENABLED=

# Lesson listen (plan 2026-07-13-lesson-listen.md). Only the exact value
# "true" opens the recorder, the lesson routes, and the cron sweep; leave
# unset until the LL-5 gateway audio spike passes and the consent copy has
# cleared both copy gates. Tone controls are optional: HOMA_LESSON_TONE=off
# disables the audio-model tone lane fleet-wide, HOMA_LESSON_TONE_MODEL
# overrides the default in lib/lessons/tone.ts.
HOMA_LESSON_LISTEN_ENABLED=
HOMA_LESSON_TONE=
HOMA_LESSON_TONE_MODEL=

# Server-only: Vercel AI Gateway key for LOCAL narrative generation and the
# fixtures script (deployed, the gateway authenticates via the Vercel
# project, same as eve chat; the Vercel OIDC dev token also works locally).
# Never commit a value.
AI_GATEWAY_API_KEY=

# Artifact persistence. Without the Blob token, material persistence is not
# available. Never expose this server-only token.
BLOB_READ_WRITE_TOKEN=

# Dedicated private Vercel Blob store for child lesson audio. This must point
# to a private store, never the public materials store.
HOMA_LESSON_READ_WRITE_TOKEN=

# Optional model and review controls. Defaults live in the referenced code.
HOMA_IMAGE_MODEL=
HOMA_MATERIALS_REVIEW=
HOMA_REVIEW_MODEL=
HOMA_MEDIA_CAPTIONS=
HOMA_CAPTION_MODEL=
HOMA_EXTRACTION_MODEL=
HOMA_SUGGESTIONS_MODEL=
HOMA_EMBEDDING_MODEL=
HOMA_REVIEW_MIN_MESSAGES=

# Stripe billing. Secret keys are server-only. Keep TEST and LIVE separate:
# local development uses TEST; LIVE values belong in Vercel Production and
# must not be copied into local files.
STRIPE_TEST_SECRET_KEY=
STRIPE_LIVE_SECRET_KEY=

# Telnyx voice + text (M5-01 groundwork experiment). API key is server-only.
# Provision or inspect resources with pnpm telnyx:provision. Read the command
# help before use because status mode may synchronize an existing assistant.
# The SMS channel (agent/channels/telnyx.ts) is DARK unless
# TELNYX_SMS_ENABLED="true" AND the key, from-number, and public key are all
# set; the public key gates Ed25519 webhook verification, so the channel
# never processes unverifiable traffic. TELNYX_SP_* are the Sole Proprietor
# 10DLC identity fields the provisioning script reads (never committed).
TELNYX_API_KEY=
TELNYX_SMS_ENABLED=
TELNYX_FROM_NUMBER=
TELNYX_MESSAGING_PROFILE_ID=
TELNYX_PUBLIC_KEY=
# Auth key for the voice assistant's dynamic-variables webhook
# (/api/voice/context?key=...); the keyed URL lives only in the Telnyx
# assistant config.
TELNYX_WEBHOOK_SECRET=
TELNYX_SP_FIRST_NAME=
TELNYX_SP_LAST_NAME=
TELNYX_SP_EMAIL=
TELNYX_SP_MOBILE=
TELNYX_SP_STREET=
TELNYX_SP_CITY=
TELNYX_SP_STATE=
TELNYX_SP_POSTAL=
# "Call Homa" curriculum feature: a second, outbound-only assistant.
# Provision with: pnpm exec tsx scripts/telnyx-curriculum-provision.mts
TELNYX_CURRICULUM_ASSISTANT_ID=
TELNYX_CURRICULUM_TEXML_APP_ID=

# Server-only: SerpAPI key for the studio's real-photo search
# (search_photos + keep_photo agent tools, lib/search/serp-images.ts).
# Unset = photo search reports itself unavailable, nothing breaks.
# Current key is the free plan (250 searches/month shared fleet-wide);
# the tools also cap per-family daily use. Safe search is forced in
# code; the signing for keep_photo tokens derives from this key.
SERPAPI_API_KEY=

# Server-only: Firecrawl key for the agent's web page reading
# (web_fetch tool, lib/search/firecrawl.ts): model-chosen URLs come
# back as size-capped markdown, budgeted per family per day. ON per
# founder ruling 2026-07-13 (supersedes the 2026-07-09 web_fetch-off
# posture; see the build log and ruling register). Unset = page
# reading reports itself unavailable, nothing breaks.
FIRECRAWL_API_KEY=

# Server-only: Twelve Labs key for the video gateway (lib/video/
# twelvelabs.ts): parents send a video, Pegasus watches it, the agent
# gets text. Unset = video understanding is skipped (SMS clips fall
# back to audio-track transcription), nothing breaks.
# Clips under the vendor floors (4s, 360x360) get a freeze-frame pad +
# upscale retry through ffmpeg/ffprobe when those binaries exist on the
# runtime (dev machines: yes; Vercel: not yet, see build-log
# 2026-07-11). Optional overrides when they live off PATH:
TWELVELABS_API_KEY=
# FFMPEG_PATH=
# FFPROBE_PATH=

# Thank-you cards (plans/2026-07-11-thank-you-cards.md): one real
# handwritten card per family via Handwrytten, 48h after web onboarding.
# DARK unless THANK_YOU_CARDS_ENABLED="true" AND the three HANDWRYTTEN_*
# values are set. Key from app.handwrytten.com/api-keys; card and font ids
# via apps/web/scripts/handwrytten-smoke.mts (list mode).
# TEST_MODE: the cron sweep runs ONLY when this is exactly "false" AND the
# vendor ACCOUNT is in live mode (their dashboard has its own test switch);
# any other value means test mode, which the smoke script uses but the
# sweep refuses, because a test order would mark a family's once-ever row
# sent while mailing nothing. MONTHLY_CAP is the spend brake, cards per
# calendar month (default 150).
THANK_YOU_CARDS_ENABLED=
THANK_YOU_CARDS_MONTHLY_CAP=
HANDWRYTTEN_API_KEY=
HANDWRYTTEN_CARD_ID=
HANDWRYTTEN_FONT=
HANDWRYTTEN_TEST_MODE=

# The wall (paywall between the free report and the acting product;
# plans/2026-07-11-the-wall.md). DARK by default: unset or anything but
# "true"/"1" keeps every door open and adds zero queries per request.
# Flip only in Phase D, after (a) this deploy's migration is applied,
# (b) the two Payment Links below carry a 7-day trial and redirect to
# /api/billing/confirm?session_id={CHECKOUT_SESSION_ID}, and (c) pricing
# goes on the site the same deploy (the FAQ promises pricing gets
# published before anyone pays). Keep LIVE and TEST keys/links in
# matching modes or the confirm route cannot verify sessions.
HOMA_WALL_ENABLED=

# The signup paywall (founder directive 2026-07-26): holds the WHOLE
# account behind a card-upfront 7-day trial the moment the account is
# created, before the questionnaire, the report, or any conversation.
# DARK by default. Independent of HOMA_WALL_ENABLED (it replaces the
# door wall for new families rather than layering on it). Flip only
# after (a) every Payment Link below carries a 7-day card-required
# trial and redirects to /api/billing/confirm, and (b)
# STRIPE_WEBHOOK_SECRET is set so subscription lapses actually end
# access. On the trial reminder (the gate promises one on day 4, three
# days before billing): Stripe's dashboard-configured trial reminder
# email fires 7 days before trial end, which for a trial this short is
# day 0, the moment of signup, so turning that toggle on does NOT keep
# this promise. Nothing in code sends a day-4 email today; either wire
# one off the customer.subscription.trial_will_end webhook (fires 3
# days before end at any trial length) before flipping this flag, or
# soften TRIAL_GATE_TIMELINE's day-4 line in wall-copy.ts until one
# exists. Remember: set Vercel env vars with --no-sensitive and
# trigger a real rebuild.
HOMA_SIGNUP_PAYWALL_ENABLED=

# Optional grandfather cutoff for the signup paywall: families created
# BEFORE this instant (any Date.parse-able value, e.g.
# 2026-07-27T00:00:00Z) are never account-gated; the door wall still
# applies to them exactly as before. Set it to the flag-flip moment to
# scope the willingness-to-pay test to new signups only. Unset, every
# non-exempt family is gated, existing ones included. A typo is ignored
# loudly (console.error), never enforced.
HOMA_SIGNUP_PAYWALL_SINCE=

# Plan-tier Payment Link URLs (regular / plus / elite), preferring LIVE in
# production and TEST elsewhere. Product names, prices, trials, redirects,
# and live account state require direct Stripe verification.
NEXT_PUBLIC_STRIPE_TEST_PAYMENT_LINK_MONTHLY_URL=
NEXT_PUBLIC_STRIPE_TEST_PAYMENT_LINK_ANNUAL_URL=
NEXT_PUBLIC_STRIPE_TEST_PAYMENT_LINK_PLUS_MONTHLY_URL=
NEXT_PUBLIC_STRIPE_TEST_PAYMENT_LINK_PLUS_ANNUAL_URL=
NEXT_PUBLIC_STRIPE_TEST_PAYMENT_LINK_ELITE_MONTHLY_URL=
NEXT_PUBLIC_STRIPE_TEST_PAYMENT_LINK_ELITE_ANNUAL_URL=
NEXT_PUBLIC_STRIPE_LIVE_PAYMENT_LINK_MONTHLY_URL=
NEXT_PUBLIC_STRIPE_LIVE_PAYMENT_LINK_ANNUAL_URL=
NEXT_PUBLIC_STRIPE_LIVE_PAYMENT_LINK_PLUS_MONTHLY_URL=
NEXT_PUBLIC_STRIPE_LIVE_PAYMENT_LINK_PLUS_ANNUAL_URL=
NEXT_PUBLIC_STRIPE_LIVE_PAYMENT_LINK_ELITE_MONTHLY_URL=
NEXT_PUBLIC_STRIPE_LIVE_PAYMENT_LINK_ELITE_ANNUAL_URL=

# Founder console (/admin, MJ-14). ADMIN_EMAILS is the comma-separated
# allowlist of founder sign-in addresses; unset means the console 404s for
# everyone (fail closed). The digest email goes out once per UTC day at
# DIGEST_HOUR_UTC (default 11, 7am Eastern in summer) when a digest
# address is set. HOMA_ADMIN_TZ controls the console's day grouping.
HOMA_ADMIN_EMAILS=
HOMA_ADMIN_DIGEST_EMAIL=
HOMA_ADMIN_DIGEST_HOUR_UTC=
HOMA_ADMIN_TZ=

# Webhook signing secrets for the delivery and billing mirrors. Both
# endpoints stay DARK (503) until their secret is set. Resend: create a
# webhook for email.delivered/bounced/complained pointing at
# /api/email/webhook and copy its whsec_ secret. Stripe: add an endpoint
# for checkout.session.completed + customer.subscription.* pointing at
# /api/billing/webhook and copy its whsec_ secret.
RESEND_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET=

# Dispatched-material delivery (founder ruling voice-dispatch-sandbox-gate,
# 2026-07-28). When a background job finishes a worksheet, the milestone text
# carries the picture and a link to the print file. Sandbox families (the
# +homatest alias) always get the attachment, so the whole path is verifiable
# end to end with this unset. Set it to exactly "true" only after watching a
# real send: the same dispatch policy auto-finalizes to the binder once QC
# passes, and the 2026-07-24 materials review found QC screenshotting the
# screen render while the print render is what ships.
HOMA_JOB_MATERIAL_DELIVERY_ENABLED=

# In-app voice (issue #283, ruling voice-openai-direct 2026-07-29). Mints the
# ephemeral client secret for a browser realtime session. It has to be a real
# OpenAI key: the AI Gateway refuses to mint realtime secrets from a Vercel
# OIDC token ("Client secrets can only be minted with a Gateway API key"),
# which is why this exists despite the model-gateway law. Every non-realtime
# model call still runs on OIDC through the gateway, and AI_GATEWAY_API_KEY
# stays forbidden. The key never reaches the browser; only the ek_ secret does.
OPENAI_API_KEY=
