# Copy to .env.local for local dev; set the same values in Vercel env vars.
# The publishable key is designed to be public; RLS is the security boundary.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Stripe sandbox/test mode (Phase D — billing, not wired into product code yet).
# Secret key is server-only: never NEXT_PUBLIC_, never client code. Publishable
# key is designed to be public, safe as NEXT_PUBLIC_.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
