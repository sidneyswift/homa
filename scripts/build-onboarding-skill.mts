/**
 * Regenerates apps/web/lib/onboarding/onboarding-skill-body.generated.ts
 * from apps/web/agent/skills/onboarding/SKILL.md.
 *
 * Why a generated mirror instead of reading the file at runtime (issue
 * #246): the onboarding preload has to reach the model on the first turn
 * of onboarding, and the deployed eve function is a nitro bundle that
 * carries no source tree. A readFileSync of agent/skills/... resolves
 * locally and throws in production, which is exactly what happened: from
 * 2026-07-24 every production onboarding session silently fell back to a
 * load_skill round trip, giving back the 17.8-23.8s to 6.3-12.1s kickoff
 * win from commit 473d99fe.
 *
 * eve 0.19's build cannot inline the markdown for us. Its resolver reads
 * `SKILL.md?raw` as a literal filename (UNLOADABLE_DEPENDENCY), and
 * `with { type: "text" }` resolves the file and then hands it to the JS
 * parser (PARSE_ERROR). So the text travels as source: pure, works in
 * Next and eve build and tsx alike, no runtime filesystem and no network
 * fetch.
 *
 * SKILL.md stays the only place anyone edits the onboarding skill
 * (filesystem-first fleet skills, founder ruling 2026-07-15). This
 * script is the only writer of the generated module. Re-run after any
 * SKILL.md edit:  pnpm build:onboarding-skill
 *
 * A stale mirror would ship an outdated skill body silently, so
 * apps/web/lib/onboarding/onboarding-mode.test.ts asserts the generated
 * constant is byte-for-byte the file, and `--check` here does the same
 * without writing. Both fail loudly rather than degrading.
 *
 * Usage:
 *   node --experimental-strip-types scripts/build-onboarding-skill.mts
 *   node --experimental-strip-types scripts/build-onboarding-skill.mts --check
 */
import { readFileSync, writeFileSync } from "node:fs";
import path from "node:path";
import { fileURLToPath } from "node:url";

const repoRoot = path.dirname(path.dirname(fileURLToPath(import.meta.url)));

const SKILL_SOURCE = "apps/web/agent/skills/onboarding/SKILL.md";
const OUT = "apps/web/lib/onboarding/onboarding-skill-body.generated.ts";

/**
 * Emits the file as one JSON-quoted string per source line, joined back
 * with newlines. A single 23kB string literal would round-trip just as
 * exactly but every SKILL.md edit would show up as one unreadable
 * changed line; per-line entries keep the generated diff reviewable.
 * split("\n").join("\n") is exact, trailing newline included.
 */
function renderGeneratedModule(rawSkill: string): string {
  const lines = rawSkill.split("\n");
  return [
    "// GENERATED by scripts/build-onboarding-skill.mts. Do not edit by hand.",
    `// A byte-exact mirror of ${SKILL_SOURCE}, inlined as source because the`,
    "// deployed eve function bundle carries no source tree to read it from",
    "// (issue #246). Regenerate with: pnpm build:onboarding-skill",
    "export const ONBOARDING_SKILL_MARKDOWN = [",
    ...lines.map((line) => `  ${JSON.stringify(line)},`),
    '].join("\\n");',
    "",
  ].join("\n");
}

const rawSkill = readFileSync(path.join(repoRoot, SKILL_SOURCE), "utf8");
const generated = renderGeneratedModule(rawSkill);

if (process.argv.includes("--check")) {
  const onDisk = readFileSync(path.join(repoRoot, OUT), "utf8");
  if (onDisk !== generated) {
    console.error(
      `${OUT} is stale: it no longer matches ${SKILL_SOURCE}.\n` +
        "Production onboarding would preload an outdated skill body.\n" +
        "Run: pnpm build:onboarding-skill",
    );
    process.exit(1);
  }
  console.log(`${OUT} matches ${SKILL_SOURCE} (${rawSkill.length} bytes).`);
} else {
  writeFileSync(path.join(repoRoot, OUT), generated, "utf8");
  console.log(`Wrote ${OUT} from ${SKILL_SOURCE} (${rawSkill.length} bytes).`);
}
