/**
 * Regenerates apps/web/lib/map/report-writer-prompt.generated.ts from
 * apps/web/agent/report-writer.md.
 *
 * Why a generated mirror instead of reading the file at runtime: the
 * report writer can be reached from the Eve-hosted onboarding tool path,
 * not only from traced Next routes. Eve's hosted Nitro output does not
 * carry the /agent source tree, so a process.cwd() read can become the
 * same ENOENT class as issue #495.
 *
 * report-writer.md stays the only place anyone edits the prompt. This
 * script is the only writer of the generated module. Re-run after any
 * prompt edit:  pnpm build:report-writer-prompt
 *
 * A stale mirror would ship outdated report voice rules silently, so
 * --check does the same comparison without writing and fails loudly.
 *
 * Usage:
 *   node --experimental-strip-types scripts/build-report-writer-prompt.mts
 *   node --experimental-strip-types scripts/build-report-writer-prompt.mts --check
 */
import { readFileSync, writeFileSync } from "node:fs";
import path from "node:path";
import { fileURLToPath } from "node:url";

const repoRoot = path.dirname(path.dirname(fileURLToPath(import.meta.url)));

const SOURCE = "apps/web/agent/report-writer.md";
const OUT = "apps/web/lib/map/report-writer-prompt.generated.ts";

/**
 * Emits one JSON-quoted string per source line, joined back with newlines.
 * That keeps prompt edits reviewable while preserving the exact file bytes,
 * including a trailing newline.
 */
function renderGeneratedModule(rawPrompt: string): string {
  return [
    "// GENERATED by scripts/build-report-writer-prompt.mts. Do not edit by hand.",
    `// A byte-exact mirror of ${SOURCE}, inlined as source because the`,
    "// deployed eve function bundle carries no source tree to read it from",
    "// (issue #495). Regenerate with: pnpm build:report-writer-prompt",
    "export const REPORT_WRITER_PROMPT = [",
    ...rawPrompt.split("\n").map((line) => `  ${JSON.stringify(line)},`),
    '].join("\\n");',
    "",
  ].join("\n");
}

const rawPrompt = readFileSync(path.join(repoRoot, SOURCE), "utf8");
const generated = renderGeneratedModule(rawPrompt);

if (process.argv.includes("--check")) {
  const onDisk = readFileSync(path.join(repoRoot, OUT), "utf8");
  if (onDisk !== generated) {
    console.error(
      `${OUT} is stale: it no longer matches ${SOURCE}.\n` +
        "Production report writing would run with outdated voice rules.\n" +
        "Run: pnpm build:report-writer-prompt",
    );
    process.exit(1);
  }
  console.log(`${OUT} matches ${SOURCE} (${rawPrompt.length} bytes).`);
} else {
  writeFileSync(path.join(repoRoot, OUT), generated, "utf8");
  console.log(`Wrote ${OUT} from ${SOURCE} (${rawPrompt.length} bytes).`);
}
