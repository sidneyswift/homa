/**
 * Regenerates apps/web/lib/learning/memory-compactor-prompt.generated.ts
 * from apps/web/agent/memory-compactor.md.
 *
 * Why a generated mirror instead of reading the file at runtime: the
 * memory compaction schedule runs inside the deployed eve Nitro function,
 * whose bundle carries compiled code and traced packages, not the source
 * tree at /agent. Issue #495 found production ENOENT on
 * /var/task/agent/memory-compactor.md every night once compaction fired.
 *
 * memory-compactor.md stays the only place anyone edits the prompt. This
 * script is the only writer of the generated module. Re-run after any
 * prompt edit:  pnpm build:memory-compactor-prompt
 *
 * A stale mirror would ship yesterday's compaction rules silently, so
 * --check does the same comparison without writing and fails loudly.
 *
 * Usage:
 *   node --experimental-strip-types scripts/build-memory-compactor-prompt.mts
 *   node --experimental-strip-types scripts/build-memory-compactor-prompt.mts --check
 */
import { readFileSync, writeFileSync } from "node:fs";
import path from "node:path";
import { fileURLToPath } from "node:url";

const repoRoot = path.dirname(path.dirname(fileURLToPath(import.meta.url)));

const SOURCE = "apps/web/agent/memory-compactor.md";
const OUT = "apps/web/lib/learning/memory-compactor-prompt.generated.ts";

/**
 * Emits one JSON-quoted string per source line, joined back with newlines.
 * That keeps prompt edits reviewable while preserving the exact file bytes,
 * including a trailing newline.
 */
function renderGeneratedModule(rawPrompt: string): string {
  return [
    "// GENERATED by scripts/build-memory-compactor-prompt.mts. Do not edit by hand.",
    `// A byte-exact mirror of ${SOURCE}, inlined as source because the`,
    "// deployed eve function bundle carries no source tree to read it from",
    "// (issue #495). Regenerate with: pnpm build:memory-compactor-prompt",
    "export const MEMORY_COMPACTOR_PROMPT = [",
    ...rawPrompt.split("\n").map((line) => `  ${JSON.stringify(line)},`),
    '].join("\\n");',
    "",
  ].join("\n");
}

const rawPrompt = readFileSync(path.join(repoRoot, SOURCE), "utf8");
const generated = renderGeneratedModule(rawPrompt);

if (process.argv.includes("--check")) {
  const onDisk = readFileSync(path.join(repoRoot, OUT), "utf8");
  if (onDisk !== generated) {
    console.error(
      `${OUT} is stale: it no longer matches ${SOURCE}.\n` +
        "Production memory compaction would run with outdated rules.\n" +
        "Run: pnpm build:memory-compactor-prompt",
    );
    process.exit(1);
  }
  console.log(`${OUT} matches ${SOURCE} (${rawPrompt.length} bytes).`);
} else {
  writeFileSync(path.join(repoRoot, OUT), generated, "utf8");
  console.log(`Wrote ${OUT} from ${SOURCE} (${rawPrompt.length} bytes).`);
}
