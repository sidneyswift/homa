/**
 * Regenerates apps/web/lib/voice/persona.generated.ts from the persona
 * slice of apps/web/agent/instructions.md.
 *
 * Why a generated mirror instead of reading the file at runtime: the same
 * reason as scripts/build-onboarding-skill.mts (issue #246). A browser
 * voice session mints its instructions inside a deployed function, and
 * that bundle carries no source tree, so a readFile of agent/... resolves
 * locally and throws in production. That exact mistake silently cost the
 * onboarding preload from 2026-07-24, and it would be worse here: the
 * persona IS Homa's voice, so a failed read does not degrade the session,
 * it replaces her with a stranger who has no rules.
 *
 * The slice is everything above "## What you know each turn", which is the
 * same cut scripts/telnyx-provision.mts takes for the phone line, because
 * everything below that heading is web-tool operations a voice session has
 * no use for. That heading is load-bearing and already guarded by
 * scripts/instructions-split-check.mts.
 *
 * instructions.md stays the only place anyone edits Homa's voice. This
 * script is the only writer of the generated module. Re-run after any
 * instructions.md edit:  pnpm build:voice-persona
 *
 * A stale mirror would ship an outdated persona silently, so --check does
 * the same comparison without writing and fails loudly.
 *
 * Usage:
 *   node --experimental-strip-types scripts/build-voice-persona.mts
 *   node --experimental-strip-types scripts/build-voice-persona.mts --check
 */
import { readFileSync, writeFileSync } from "node:fs";
import path from "node:path";
import { fileURLToPath } from "node:url";

const repoRoot = path.dirname(path.dirname(fileURLToPath(import.meta.url)));

const SOURCE = "apps/web/agent/instructions.md";
const OUT = "apps/web/lib/voice/persona.generated.ts";
const SPLIT_HEADING = "## What you know each turn";
const COMMENT = /<!--[\s\S]*?-->/u;

/** One JSON-quoted string per source line, joined back with newlines, so a
 * persona edit shows up as a reviewable diff rather than one unreadable
 * changed line. */
function renderGeneratedModule(persona: string): string {
  return [
    "// GENERATED by scripts/build-voice-persona.mts. Do not edit by hand.",
    `// The persona slice of ${SOURCE} (everything above`,
    `// "${SPLIT_HEADING}"), inlined as source because a deployed`,
    "// function bundle carries no source tree to read it from (issue #246).",
    "// Regenerate with: pnpm build:voice-persona",
    "export const VOICE_PERSONA_MARKDOWN = [",
    ...persona.split("\n").map((line) => `  ${JSON.stringify(line)},`),
    '].join("\\n");',
    "",
  ].join("\n");
}

const full = readFileSync(path.join(repoRoot, SOURCE), "utf8");
if (!full.includes(SPLIT_HEADING)) {
  console.error(
    `${SOURCE} no longer contains "${SPLIT_HEADING}".\n` +
      "That heading is where the voice persona stops and web-tool operations\n" +
      "begin. Without it the whole file would ship as the persona.",
  );
  process.exit(1);
}
const persona = full.split(SPLIT_HEADING)[0].replace(COMMENT, "").trim();
const generated = renderGeneratedModule(persona);

if (process.argv.includes("--check")) {
  const onDisk = readFileSync(path.join(repoRoot, OUT), "utf8");
  if (onDisk !== generated) {
    console.error(
      `${OUT} is stale: it no longer matches the persona slice of ${SOURCE}.\n` +
        "A browser voice session would speak with an outdated persona.\n" +
        "Run: pnpm build:voice-persona",
    );
    process.exit(1);
  }
  console.log(`${OUT} matches ${SOURCE} (${persona.length} bytes of persona).`);
} else {
  writeFileSync(path.join(repoRoot, OUT), generated, "utf8");
  console.log(`Wrote ${OUT} from ${SOURCE} (${persona.length} bytes of persona).`);
}
